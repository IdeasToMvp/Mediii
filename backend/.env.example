PORT=3200
OPENAI_API_KEY=sk-...

# Supabase (anon + service role: required for Razorpay webhooks to update entitlements)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Razorpay — same API keys for all plans (monthly/yearly are different *plan ids*, not different keys)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=... 

# Optional: default currency (INR typical for Razorpay India)
RAZORPAY_CURRENCY=INR

# Two Pro plans in Razorpay Dashboard (billing period + price are fixed per plan and cannot be changed later):
# - Create one Plan for monthly billing, one for annual — each gets its own plan_… id from the dashboard.
RAZORPAY_PLAN_ID_PRO_MONTHLY=plan_...
RAZORPAY_PLAN_ID_PRO_ANNUAL=plan_...

# Optional legacy: if set and RAZORPAY_PLAN_ID_PRO_MONTHLY is empty, treated as the monthly plan id
# RAZORPAY_PLAN_ID_PRO=plan_...

# Optional: max billing cycles for the subscription (default 120)
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120

# Android APK distribution (Supabase bucket app-distributions + app_releases table — run migration 011)
# Postman: POST /api/admin/app-releases  multipart  Header: X-Admin-Upload-Token
APK_ADMIN_UPLOAD_TOKEN=long-random-secret
# Optional: signed download link lifetime in seconds (default 3600)
# APK_DOWNLOAD_URL_TTL_SEC=3600
